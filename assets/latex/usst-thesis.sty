\ifXeTeX\else\PackageError{usst-thesis}{Use XeLaTeX or Tectonic}{This template uses the XeTeX Chinese font engine.}\fi
\RequirePackage{fontspec}
\input{fonts.tex}
\RequirePackage[a4paper,top=3.5cm,bottom=2.5cm,left=3cm,right=3cm,headheight=14bp,headsep=1.5cm,footskip=0.5cm]{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{amsmath,amssymb,graphicx,booktabs,longtable}
\RequirePackage{caption}
\RequirePackage[superscript]{cite}
\RequirePackage[hidelinks,unicode]{hyperref}
\urlstyle{same}
\RequirePackage{bookmark}
% Book's front/main matter also use cleardoublepage, even with openany.
\let\cleardoublepage\clearpage

% bp equals the 1/72 inch point used by Word. TeX's pt is slightly smaller.
\renewcommand{\normalsize}{\fontsize{12bp}{20bp}\selectfont
  \setlength{\abovedisplayskip}{6bp}\setlength{\belowdisplayskip}{6bp}
  \setlength{\abovedisplayshortskip}{6bp}\setlength{\belowdisplayshortskip}{6bp}}
\AtBeginDocument{\linespread{1}\normalsize\songti}
\setlength{\parindent}{2em}
\setlength{\parskip}{0bp}
\setlength{\emergencystretch}{1em}
\raggedbottom
\ctexset{
  chapter={name={第,章},number=\chinese{chapter},format=\centering\heiti\fontsize{18bp}{21.6bp}\selectfont,
    aftername=\hspace{1em},beforeskip=24bp,afterskip=18bp,fixskip=true},
  section={format=\raggedright\songti\bfseries\fontsize{14bp}{20bp}\selectfont,
    aftername=\hspace{1em},beforeskip=24bp,afterskip=6bp},
  subsection={format=\raggedright\songti\bfseries\fontsize{12bp}{20bp}\selectfont,
    aftername=\hspace{1em},beforeskip=12bp,afterskip=6bp}
}
\setcounter{secnumdepth}{2}
\setcounter{tocdepth}{2}
\renewcommand{\chaptermark}[1]{\markboth{第\chinese{chapter}章\quad #1}{}}
\newcommand{\usstheader}{%
  \fancyhf{}
  \fancyhfinit{\fontsize{10.5bp}{12.6bp}\selectfont}
  \fancyhead[CE]{{\songti\fontsize{10.5bp}{12.6bp}\selectfont 上海理工大学博士学位论文}}
  \fancyhead[CO]{{\songti\fontsize{10.5bp}{12.6bp}\selectfont\nouppercase{\leftmark}}}
  \fancyfoot[C]{{\rmfamily\fontsize{10.5bp}{12.6bp}\selectfont\thepage}}
  \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}
\pagestyle{fancy}\usstheader
\fancypagestyle{plain}{\usstheader}
\newcommand{\usstfrontchapter}[1]{\chapter*{#1}\markboth{#1}{#1}}
\renewcommand{\contentsname}{目录}
\renewcommand{\bibname}{参考文献}
% Only chapter/section/subsection entries; abstracts and the TOC stay outside the TOC.
\renewcommand*{\l@chapter}[2]{\@dottedtocline{0}{0em}{4.5em}{#1}{#2}}
\renewcommand*{\l@section}[2]{\@dottedtocline{1}{1em}{2.5em}{#1}{#2}}
\renewcommand*{\l@subsection}[2]{\@dottedtocline{2}{2em}{3.5em}{#1}{#2}}

\renewcommand{\thefigure}{\thechapter.\arabic{figure}}
\renewcommand{\thetable}{\thechapter.\arabic{table}}
\renewcommand{\theequation}{\thechapter.\arabic{equation}}
\DeclareCaptionFont{usst}{\songti\fontsize{12bp}{14.4bp}\selectfont}
\captionsetup{font=usst,labelsep=quad,justification=centering}
\captionsetup[figure]{position=bottom,aboveskip=6bp,belowskip=12bp}
\captionsetup[table]{position=top,aboveskip=12bp,belowskip=6bp}
\newcommand{\ussttablefont}{\songti\fontsize{10.5bp}{12.6bp}\selectfont}
% Add to the first cell of each single-line table row: 3 bp above and below.
\newcommand{\ussttablerow}{\rule[-6.78bp]{0pt}{18.6bp}}
\renewcommand{\citeleft}{[}\renewcommand{\citeright}{]}
% cite's superscript mode bypasses citeleft/citeright unless explicitly wrapped.
\renewcommand{\@citess}[1]{\textsuperscript{\normalfont\citeleft#1\citeright}}

\renewenvironment{thebibliography}[1]{%
  \chapter*{\bibname}\markboth{\bibname}{\bibname}
  \phantomsection\addcontentsline{toc}{chapter}{\bibname}
  \fontsize{12bp}{16bp}\selectfont
  \list{[\arabic{enumiv}]}{\settowidth{\labelwidth}{[#1]}\setlength{\labelsep}{0.5em}
    \setlength{\leftmargin}{\labelwidth}\addtolength{\leftmargin}{\labelsep}
    \usecounter{enumiv}\setlength{\itemsep}{3bp}\setlength{\parsep}{0bp}\setlength{\topsep}{0bp}}
  \sloppy\raggedright
}{\endlist}
\newcommand{\usstappendix}{\appendix
  \ctexset{chapter={name={附录,},number=\Alph{chapter}}}
  \renewcommand{\chaptermark}[1]{\markboth{附录\thechapter\quad ##1}{}}
  \renewcommand{\theequation}{\thechapter-\arabic{equation}}}
\endinput
